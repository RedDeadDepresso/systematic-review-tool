
# Backend api url used by frontend. Should be same as http:// + SITE_DOMAIN + /api
# After setting ssl certificate change http to https
VITE_API_BASE_URL=http://localhost:8000/api


# Backend websocket url used by frontend. Should be same as ws:// + SITE_DOMAIN + /ws
# After setting ssl certificate change ws to wss
VITE_WS_URL=ws://localhost:8000/ws